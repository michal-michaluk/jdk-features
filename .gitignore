.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
# Un-ignore the whole .idea dir (the parent repo ignores it), then re-ignore only the
# volatile / machine-specific files. IntelliJ's own .idea/.gitignore also excludes these.
!.idea/
.idea/workspace.xml
.idea/db-forest-config.xml
.idea/dataSources/
.idea/dataSources.local.xml
.idea/httpRequests/
.idea/shelf/
.idea/queries/
.idea/usage.statistics.xml
*.iml
out/

# Playwright CLI tooling artifacts (session screenshots / logs)
.playwright-cli/

# Standard
# OS
.DS_Store
Thumbs.db

# IDE (generic editor droppings)
*.log

# Node (if any tooling drags it in)
node_modules/
